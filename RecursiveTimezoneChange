# Connect to Exchange Online
Connect-ExchangeOnline -UserPrincipalName you@yourcompany.com

# --- CONFIGURATION ---
$desiredTimeZone = "GMT Standard Time" # Europe/London
$targetCurrentTimeZone = "Pacific Standard Time" # UTC-8
$dryRun = $true # Set to $false to perform real update
# ----------------------

# Get all user mailboxes
$mailboxes = Get-Mailbox -ResultSize Unlimited -RecipientTypeDetails UserMailbox

# Array to track users to update
$usersToUpdate = @()

# First pass: identify users needing update
foreach ($mailbox in $mailboxes) {
    $regionalConfig = Get-MailboxRegionalConfiguration -Identity $mailbox.UserPrincipalName
    if ($regionalConfig.TimeZone -eq $targetCurrentTimeZone) {
        $usersToUpdate += [PSCustomObject]@{
            UserPrincipalName = $mailbox.UserPrincipalName
            CurrentTimeZone   = $regionalConfig.TimeZone
            NewTimeZone       = $desiredTimeZone
        }
    }
}

# Report users to be updated
if ($usersToUpdate.Count -eq 0) {
    Write-Host "No users found with time zone set to '$targetCurrentTimeZone'. No changes will be made." -ForegroundColor Green
} else {
    Write-Host "`nUsers to be updated:" -ForegroundColor Yellow
    $usersToUpdate | Format-Table UserPrincipalName, CurrentTimeZone, NewTimeZone

    # Confirm before proceeding
    $confirmation = Read-Host "`nProceed to process these $($usersToUpdate.Count) users? (Y/N)"
    if ($confirmation -eq "Y") {
        # Log file
        $logFile = "TimeZoneUpdateLog_$(Get-Date -Format 'yyyyMMdd_HHmmss').txt"
        Add-Content -Path $logFile -Value "Time Zone Update Log - $(Get-Date)"
        Add-Content -Path $logFile -Value "======================================`n"

        foreach ($user in $usersToUpdate) {
            if ($dryRun) {
                Write-Host "[Dry Run] Would update $($user.UserPrincipalName): $($user.CurrentTimeZone) -> $desiredTimeZone" -ForegroundColor Yellow
                Add-Content -Path $logFile -Value "[Dry Run] Would update $($user.UserPrincipalName): $($user.CurrentTimeZone) -> $desiredTimeZone"
            } else {
                Write-Host "Updating $($user.UserPrincipalName) to $desiredTimeZone" -ForegroundColor Cyan
                Set-MailboxRegionalConfiguration -Identity $user.UserPrincipalName -TimeZone $desiredTimeZone
                Add-Content -Path $logFile -Value "Updated $($user.UserPrincipalName): $($user.CurrentTimeZone) -> $desiredTimeZone"
            }
        }

        if ($dryRun) {
            Write-Host "`nDry Run complete. No changes were made. Log saved to $logFile" -ForegroundColor Green
        } else {
            Write-Host "`nAll updates complete. Log saved to $logFile" -ForegroundColor Green
        }
    } else {
        Write-Host "No changes made." -ForegroundColor Red
    }
}

# Disconnect session
Disconnect-ExchangeOnline
